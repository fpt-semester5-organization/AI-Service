INTERNAL_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
# Local/VPS: đường dẫn tệp JSON service account (KHÔNG commit). Cloud Run dùng service account gắn sẵn.
GOOGLE_APPLICATION_CREDENTIALS=
# Hoặc nếu chạy thử nghiệm với Google AI Studio API key trực tiếp: đặt GOOGLE_GENAI_USE_VERTEXAI=false và điền key bên dưới
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=10
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=veggielife_knowledge
RAG_TOP_K=5
RAG_MIN_SCORE=0.65
RAG_TIMEOUT_SECONDS=3
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP=50
KNOWLEDGE_DIR=knowledge/nutrition
PORT=8080
# Swagger UI tại /docs (chỉ local/staging)
ENABLE_DOCS=false
