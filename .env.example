INTERNAL_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
# Local/VPS: đường dẫn tệp JSON service account (KHÔNG commit). Cloud Run dùng service account gắn sẵn.
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=10
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=veggielife_knowledge
RAG_TOP_K=5
RAG_MIN_SCORE=0.65
RAG_TIMEOUT_SECONDS=3
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP=50
KNOWLEDGE_DIR=knowledge/nutrition
PORT=8080
# Swagger UI tại /docs (chỉ local/staging)
ENABLE_DOCS=false

# --- stt-service (Cloud Run, D119) ---
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=vi
WHISPER_CPU_THREADS=0          # Cloud Run: bằng số vCPU (deploy_stt.sh tự đặt)
WHISPER_BEAM_SIZE=5
STT_MIN_SECONDS=10
STT_MAX_SECONDS=300
STT_MIN_SAMPLE_RATE=16000
STT_MAX_UPLOAD_MB=100
STT_ALLOWED_VIDEO_HOSTS=res.cloudinary.com
STT_DOWNLOAD_TIMEOUT_SECONDS=60
STT_CONCURRENCY=1
